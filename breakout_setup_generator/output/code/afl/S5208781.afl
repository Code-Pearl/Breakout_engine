// Generated by Breakout Setup Generator -- strategy_id S5208781
// Example code only! NOT actual trading strategy!
// THIS CODE IS FOR EDUCATIONAL PURPOSES ONLY. Verify before using.
// MARKET: YOUR_MARKET   TIMEFRAME: YOUR_TIMEFRAME   DIRECTION: LONG
// DNA: prev_low|time_window_open|poi_anchored_stop|long

SetOption("MaxOpenPositions", 1);
Fract = 0.5;
SessionStart = 093000; SessionEnd = 153000;  // HHMMSS, edit for your market's hours

// Point Of Initiation
POI = Ref(L, -1);

// ATR / SPACE (distance from the POI)
ATRval = ATR(10);
SPACE = Fract * ATRval;

// The BreakoutLevel (POI + SPACE)
BreakoutLevel = POI + SPACE;

// Filter
FilterCond = TimeNum() >= SessionStart AND TimeNum() < SessionStart + (SessionEnd - SessionStart) / 3;

// Entry Condition (breaks through the level, filled next bar)
Buy = Ref(FilterCond AND Cross(C, BreakoutLevel), -1);
BuyPrice = Open;

// Exit
// stop sits at the POI level itself (a real support/resistance line),
// not an ATR multiple -- only the target is tunable
TargetMult = 5.0;
StopDistPts = Open - POI;  // distance from today's fill to the POI, in points
ApplyStop(stopTypeLoss, stopModePoint, StopDistPts, True);
ApplyStop(stopTypeProfit, stopModePoint, TargetMult * ATRval, True);
Sell = 0;  // handled by ApplyStop() above
SellPrice = Open;

// Optional hard backstop -- uncomment and size for your market/point value
// ApplyStop(stopTypeLoss, stopModePoint, 1500, True);