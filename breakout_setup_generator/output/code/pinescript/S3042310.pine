//@version=5
strategy("BSG S3042310", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=10)
// Generated by Breakout Setup Generator -- strategy_id S3042310
// Example code only! NOT actual trading strategy!
// THIS CODE IS FOR EDUCATIONAL PURPOSES ONLY. Verify before using.
// MARKET: YOUR_MARKET   TIMEFRAME: YOUR_TIMEFRAME   DIRECTION: LONG
// DNA: donchian_low20|shallow_pullback_long|atr_stop_target|long

fract = input.float(1.0, "Distance (x ATR)")
stopMult = input.float(2.5, "Stop (x ATR)")
targetMult = input.float(3.0, "Target (x ATR)")

// Point Of Initiation
poi = ta.lowest(low, 20)[1]

// ATR / space (distance from the POI)
atrVal = ta.atr(20)
space = fract * atrVal

// The BreakoutLevel (POI + space)
breakoutLevel = poi + space

filterCond = (ta.highest(high, 10)[1] - close[1]) < 1.0 * ta.atr(14)

// Entry Condition
entrySignal = close > breakoutLevel and filterCond and strategy.position_size == 0
if entrySignal
    strategy.entry("Long", strategy.long)

// Exit
stopPrice = strategy.position_avg_price - stopMult * atrVal
targetPrice = strategy.position_avg_price + targetMult * atrVal
strategy.exit("Exit", "Long", stop=stopPrice, limit=targetPrice)

// Optional hard backstop -- uncomment and size for your market/point value
// strategy.exit("Backstop", stop=strategy.position_avg_price - 1500 * syminfo.mintick)