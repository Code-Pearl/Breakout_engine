//@version=5
strategy("BSG S4651305", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=10)
// Generated by Breakout Setup Generator -- strategy_id S4651305
// Example code only! NOT actual trading strategy!
// THIS CODE IS FOR EDUCATIONAL PURPOSES ONLY. Verify before using.
// MARKET: YOUR_MARKET   TIMEFRAME: YOUR_TIMEFRAME   DIRECTION: LONG
// DNA: sma20|shallow_pullback_long|time_exit|long

fract = input.float(3.0, "Distance (x ATR)")
holdBars = input.int(5, "Hold (bars)")

// Point Of Initiation
poi = ta.sma(close, 20)[1]

// ATR / space (distance from the POI)
atrVal = ta.atr(10)
space = fract * atrVal

// The BreakoutLevel (POI + space)
breakoutLevel = poi + space

filterCond = (ta.highest(high, 10)[1] - close[1]) < 1.5 * ta.atr(14)

// Entry Condition
entrySignal = close > breakoutLevel and filterCond and strategy.position_size == 0
if entrySignal
    strategy.entry("Long", strategy.long)

// Exit
barsInTrade = strategy.opentrades > 0 ? bar_index - strategy.opentrades.entry_bar_index(strategy.opentrades - 1) : 0
if barsInTrade >= holdBars
    strategy.close("Long")

// Optional hard backstop -- uncomment and size for your market/point value
// strategy.exit("Backstop", stop=strategy.position_avg_price - 1500 * syminfo.mintick)