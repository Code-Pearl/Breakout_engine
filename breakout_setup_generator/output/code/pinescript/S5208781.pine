//@version=5
strategy("BSG S5208781", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=10)
// Generated by Breakout Setup Generator -- strategy_id S5208781
// Example code only! NOT actual trading strategy!
// THIS CODE IS FOR EDUCATIONAL PURPOSES ONLY. Verify before using.
// MARKET: YOUR_MARKET   TIMEFRAME: YOUR_TIMEFRAME   DIRECTION: LONG
// DNA: prev_low|time_window_open|poi_anchored_stop|long

fract = input.float(0.5, "Distance (x ATR)")
targetMult = input.float(5.0, "Target (x ATR)")
sessionStartMin = input.int(570, "Session start (minutes since midnight)")   // 09:30
sessionEndMin = input.int(930, "Session end (minutes since midnight)")        // 15:30

// Point Of Initiation
poi = low[1]

// ATR / space (distance from the POI)
atrVal = ta.atr(10)
space = fract * atrVal

// The BreakoutLevel (POI + space)
breakoutLevel = poi + space

minOfDay = hour * 60 + minute
sessionThird = (sessionEndMin - sessionStartMin) / 3
filterCond = minOfDay >= sessionStartMin and minOfDay < sessionStartMin + sessionThird

// Entry Condition
entrySignal = close > breakoutLevel and filterCond and strategy.position_size == 0
if entrySignal
    strategy.entry("Long", strategy.long)

// Exit
// stop sits at the POI level itself (a real support/resistance line),
// not an ATR multiple -- only the target is tunable
stopPrice = poi
targetPrice = strategy.position_avg_price + targetMult * atrVal
strategy.exit("Exit", "Long", stop=stopPrice, limit=targetPrice)

// Optional hard backstop -- uncomment and size for your market/point value
// strategy.exit("Backstop", stop=strategy.position_avg_price - 1500 * syminfo.mintick)