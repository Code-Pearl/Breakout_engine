//@version=5
strategy("BSG S7975658", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=10)
// Generated by Breakout Setup Generator -- strategy_id S7975658
// Example code only! NOT actual trading strategy!
// THIS CODE IS FOR EDUCATIONAL PURPOSES ONLY. Verify before using.
// MARKET: YOUR_MARKET   TIMEFRAME: YOUR_TIMEFRAME   DIRECTION: LONG
// DNA: highest_high_10|none|eod_exit|long

fract = input.float(0.75, "Distance (x ATR)")

// Point Of Initiation
poi = ta.highest(high, 10)[1]

// ATR / space (distance from the POI)
atrVal = ta.atr(20)
space = fract * atrVal

// The BreakoutLevel (POI + space)
breakoutLevel = poi + space

filterCond = true

// Entry Condition
entrySignal = close > breakoutLevel and filterCond and strategy.position_size == 0
if entrySignal
    strategy.entry("Long", strategy.long)

// Exit
// close out at the end of the entry session (SetExitOnClose equivalent)
newSessionExit = ta.change(time("D"))[1] != 0  // True on the first bar of a NEW session,
                                                 // i.e. one bar after the prior session ended
if newSessionExit and strategy.position_size != 0
    strategy.close("Long")

// Optional hard backstop -- uncomment and size for your market/point value
// strategy.exit("Backstop", stop=strategy.position_avg_price - 1500 * syminfo.mintick)